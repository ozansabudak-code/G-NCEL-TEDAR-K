        for doc_key, doc_name in docs_turkish.items():
            status = compliance['documents'][doc_key]
            status_icon = "✅" if status else "❌"
            result_text.insert("end", f"{status_icon} {doc_name} - {'MEVCUT' if status else 'EKSİK'}\n")
