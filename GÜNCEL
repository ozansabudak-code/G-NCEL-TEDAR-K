            personalized_content = content.replace("{{Tedarikçi Adı}}", tedarikci)
            personalized_content = personalized_content.replace("{{Yetkili Kişi}}", yetkili)
            personalized_content = personalized_content.replace("{{Eksik Evraklar}}", eksik_evraklar)
            
            try:
                # SMTP ile mail gönder
                msg = MIMEMultipart()
                msg['From'] = GMAIL_USER
                msg['To'] = mail
                msg['Subject'] = subject
                
                # HTML formatında mail içeriği
                html_content = f"""
                <html>
                <body style="font-family: 'Segoe UI', Arial, sans-serif; line-height: 1.6; color: #333;">
                    <div style="max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; border-radius: 5px;">
                        <div style="background-color: #16a085; color: white; padding: 15px; border-radius: 5px 5px 0 0;">
                            <h2 style="margin: 0;">🏛️ Tedarikçi Uyumluluk Merkezi</h2>
                        </div>
                        <div style="padding: 20px; background-color: #f9f9f9;">
                            <pre style="font-family: 'Segoe UI', Arial, sans-serif; white-space: pre-wrap; word-wrap: break-word;">{personalized_content}</pre>
                        </div>
                        <div style="text-align: center; padding: 10px; background-color: #ecf0f1; border-radius: 0 0 5px 5px; font-size: 12px; color: #7f8c8d;">
                            Bu email Tedarikçi Uyumluluk Sistemi tarafından otomatik oluşturulmuştur.
                        </div>
                    </div>
                </body>
                </html>
                """
                
                msg.attach(MIMEText(html_content, 'html'))
                
                # SMTP sunucusuna bağlan ve gönder
                server = smtplib.SMTP('smtp.gmail.com', 587)
                server.starttls()
                server.login(GMAIL_USER, GMAIL_APP_PASSWORD)
                server.send_message(msg)
                server.quit()
                
                success_count += 1
                activity_logger.log_email_sent(mail, subject, "Tedarikçi Uyumluluk")
                
            except Exception as e:
                fail_count += 1
                print(f"Mail gönderme hatası ({mail}): {e}")
        
        # Sonuç mesajı
        result_msg = f"Başarılı: {success_count}\nBaşarısız: {fail_count}"
        if empty_email_count > 0:
            result_msg += f"\nBoş mail adresi: {empty_email_count}"
            result_msg += "\n\nÖnemli: Bazı kayıtlarda mail adresi boş olduğu için gönderilemedi!"
        
