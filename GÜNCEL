    def check_expiration_status():
        """Sözleşme ve sertifikaların süre durumunu kontrol et"""
        from datetime import datetime, timedelta
        
        records = load_cari_bilgiler()
        today = datetime.now().date()
        
        # Debug logging
        print(f"\n[ALARM DEBUG] Toplam kayıt sayısı: {len(records)}")
        
        results = {
            'sozlesme_expired': [],
            'sozlesme_expiring': [],
            'sozlesme_valid': [],
            'sertifika_expired': [],
            'sertifika_expiring': [],
            'sertifika_valid': []
        }
        
        sozlesme_checked = 0
        sertifika_checked = 0
        sozlesme_parse_errors = 0
        sertifika_parse_errors = 0
        
        for idx, record in enumerate(records):
            tedarikci = record.get('Tedarikçi Adı', '')
            mail = record.get('Mail', '')
            
            # Debug: Show first record details
            if idx == 0:
                print(f"[ALARM DEBUG] İlk kayıt sütunları: {list(record.keys())}")
                print(f"[ALARM DEBUG] İlk kayıt - Tedarikçi: {tedarikci}")
            
            # Sözleşme kontrolü
            sozlesme_str = str(record.get('Sözleşme Bitiş Tarihi', '')).strip()
            if idx == 0:
                print(f"[ALARM DEBUG] İlk kayıt - Sözleşme değeri: '{sozlesme_str}'")
            
            if sozlesme_str and sozlesme_str != '' and sozlesme_str != 'nan':
                sozlesme_checked += 1
                try:
                    sozlesme_date = datetime.strptime(sozlesme_str[:10], '%Y-%m-%d').date()
                    days_diff = (sozlesme_date - today).days
                    
                    if days_diff < 0:
                        results['sozlesme_expired'].append({
                            'tedarikci': tedarikci,
                            'mail': mail,
                            'date': sozlesme_str,
                            'days': abs(days_diff)
                        })
                    elif days_diff <= 15:
                        results['sozlesme_expiring'].append({
                            'tedarikci': tedarikci,
                            'mail': mail,
                            'date': sozlesme_str,
                            'days': days_diff
                        })
                    else:
                        results['sozlesme_valid'].append({
                            'tedarikci': tedarikci,
                            'date': sozlesme_str,
                            'days': days_diff
                        })
                except Exception as e:
                    sozlesme_parse_errors += 1
                    if sozlesme_parse_errors <= 3:  # Log first 3 errors
                        print(f"[ALARM DEBUG] Sözleşme parse hatası ({tedarikci}): {sozlesme_str} - {e}")
            
            # Sertifika kontrolü
            sertifika_str = str(record.get('Sertifika Bitiş Tarihi', '')).strip()
            if idx == 0:
                print(f"[ALARM DEBUG] İlk kayıt - Sertifika değeri: '{sertifika_str}'")
            
            if sertifika_str and sertifika_str != '' and sertifika_str != 'nan':
                sertifika_checked += 1
                try:
                    sertifika_date = datetime.strptime(sertifika_str[:10], '%Y-%m-%d').date()
                    days_diff = (sertifika_date - today).days
                    
                    if days_diff < 0:
                        results['sertifika_expired'].append({
                            'tedarikci': tedarikci,
                            'mail': mail,
                            'date': sertifika_str,
                            'days': abs(days_diff)
                        })
                    elif days_diff <= 15:
                        results['sertifika_expiring'].append({
                            'tedarikci': tedarikci,
                            'mail': mail,
                            'date': sertifika_str,
                            'days': days_diff
                        })
                    else:
                        results['sertifika_valid'].append({
                            'tedarikci': tedarikci,
                            'date': sertifika_str,
                            'days': days_diff
                        })
                except Exception as e:
                    sertifika_parse_errors += 1
                    if sertifika_parse_errors <= 3:  # Log first 3 errors
                        print(f"[ALARM DEBUG] Sertifika parse hatası ({tedarikci}): {sertifika_str} - {e}")
        
        # Summary logging
        print(f"[ALARM DEBUG] İşlenen sözleşme sayısı: {sozlesme_checked}")
        print(f"[ALARM DEBUG] İşlenen sertifika sayısı: {sertifika_checked}")
        print(f"[ALARM DEBUG] Sözleşme parse hataları: {sozlesme_parse_errors}")
        print(f"[ALARM DEBUG] Sertifika parse hataları: {sertifika_parse_errors}")
        print(f"[ALARM DEBUG] Sonuç - Sözleşme süresi dolmuş: {len(results['sozlesme_expired'])}")
        print(f"[ALARM DEBUG] Sonuç - Sözleşme yakında dolacak: {len(results['sozlesme_expiring'])}")
        print(f"[ALARM DEBUG] Sonuç - Sözleşme geçerli: {len(results['sozlesme_valid'])}")
        print(f"[ALARM DEBUG] Sonuç - Sertifika süresi dolmuş: {len(results['sertifika_expired'])}")
        print(f"[ALARM DEBUG] Sonuç - Sertifika yakında dolacak: {len(results['sertifika_expiring'])}")
