def show_eksik_fazla_analysis():
    """Seçili tedarikçi için eksik-fazla yükleme analizini gösterir"""
    if df_global is None:
        messagebox.showwarning("Uyarı", "Lütfen önce veri yükleyin!")
        return
    
    selected_supplier = eksik_fazla_supplier_combo.get()
    if not selected_supplier:
        messagebox.showwarning("Uyarı", "Lütfen bir tedarikçi seçin!")
        return
    
    # Treeview'i temizle
    for item in eksik_fazla_treeview.get_children():
        eksik_fazla_treeview.delete(item)
    
    # Veriyi hazırla
    df_analysis = df_global.copy()
    
    # Gerekli kolonları bul
    date_col = find_col_by_keywords(df_analysis, ["tarih", "date"])
    siparis_no_col = find_col_by_keywords(df_analysis, ["sipariş no", "siparis no", "order no", "order number", "sipariş numarası"])
    siparis_miktar_col = find_col_by_keywords(df_analysis, ["sipariş miktarı", "siparis miktari", "order quantity"])
    kalan_col = find_col_by_keywords(df_analysis, ["kalan", "remaining", "kalan miktar"])
    
    if not date_col or not siparis_no_col:
        messagebox.showerror("Hata", "Tarih veya Sipariş No kolonu bulunamadı!")
        return
    
    # Tedarikçi filtresi
    if selected_supplier != "Tümü":
        df_analysis = df_analysis[df_analysis[tedarikci_col_global] == selected_supplier]
    
    if df_analysis.empty:
        messagebox.showinfo("Bilgi", "Seçili tedarikçi için veri bulunamadı.")
        return
    
    # Tarih dönüşümü
    df_analysis[date_col] = pd.to_datetime(df_analysis[date_col], errors='coerce')
    df_analysis = df_analysis.dropna(subset=[date_col])
    
    # Sipariş Miktarı kolonu kontrolü
    if siparis_miktar_col:
        df_analysis[siparis_miktar_col] = pd.to_numeric(df_analysis[siparis_miktar_col].astype(str).str.replace(',', '.'), errors='coerce')
    else:
        # Sipariş Miktarı yoksa, alternatif Miktar kolonunu ara
        miktar_col = find_col_by_keywords(df_analysis, ["miktar", "adet", "quantity", "qty"])
        if miktar_col:
            df_analysis[miktar_col] = pd.to_numeric(df_analysis[miktar_col].astype(str).str.replace(',', '.'), errors='coerce')
            siparis_miktar_col = miktar_col
        else:
            messagebox.showerror("Hata", "Sipariş Miktarı veya Miktar kolonu bulunamadı!")
            return
    
    # Kalan Miktar dönüşümü
    if kalan_col:
        df_analysis[kalan_col] = pd.to_numeric(df_analysis[kalan_col].astype(str).str.replace(',', '.'), errors='coerce')
    else:
        # Kalan miktar kolonu yoksa, sıfır olarak varsay (tam yükleme)
        df_analysis['_kalan_temp'] = 0
        kalan_col = '_kalan_temp'
    
    # Ay bilgisini ekle
    df_analysis['Ay'] = df_analysis[date_col].dt.to_period('M')
    
    # Benzersiz kombinasyon oluştur: Sipariş No + Sipariş Miktarı
    # Aynı sipariş no ancak farklı miktarlar olabilir, bunları ayrı tutmalıyız
    df_analysis['_unique_key'] = df_analysis[siparis_no_col].astype(str) + '_' + df_analysis[siparis_miktar_col].astype(str)
    
    # Her benzersiz kombinasyon için sadece BİR KAYIT al (ilk kaydı al)
    # Aynı sipariş no + sipariş miktarı birden fazla satırda olabilir, ama biz sadece birini alıyoruz
    df_unique_orders = df_analysis.drop_duplicates(subset=['_unique_key'], keep='first')
    
    # Aylık gruplama - Her ay için siparişleri grupla
    monthly_summary = df_unique_orders.groupby('Ay').agg({
        siparis_miktar_col: 'sum',  # Aylık toplam sipariş miktarı
        kalan_col: 'sum'  # Aylık toplam kalan miktar (her sipariş için tek bir değer)
    }).reset_index()
    
    # Yüklenen miktarı hesapla (Sipariş Miktarı - Kalan Miktar = Yüklenen)
    monthly_summary['Yüklenen'] = monthly_summary[siparis_miktar_col] - monthly_summary[kalan_col]
    
    # Özet istatistikler
    total_months = len(monthly_summary)
    tam_yukleme = len(monthly_summary[monthly_summary[kalan_col] == 0])
    eksik_yukleme = len(monthly_summary[monthly_summary[kalan_col] > 0])
    fazla_yukleme = len(monthly_summary[monthly_summary[kalan_col] < 0])
    
    # Sonuçları treeview'e ekle
    for idx, row in monthly_summary.iterrows():
        ay_str = str(row['Ay'])
        siparis = row[siparis_miktar_col]
        yuklenen = row['Yüklenen']
        kalan = row[kalan_col]
        
        # Durumu belirle
        if kalan == 0:
            durum = "✅ Tam Yükleme"
            tag = "tam"
        elif kalan > 0:
            durum = f"⚠️ Eksik Yükleme ({kalan:.0f} eksik)"
            tag = "eksik"
        else:
            durum = f"📈 Fazla Yükleme ({abs(kalan):.0f} fazla)"
            tag = "fazla"
        
        eksik_fazla_treeview.insert("", "end", values=(
            ay_str,
            f"{siparis:,.0f}",
            f"{yuklenen:,.0f}",
            f"{kalan:,.0f}",
            durum
        ), tags=(tag,))
    
    # Özet bilgiyi güncelle
    total_siparis = monthly_summary[siparis_miktar_col].sum()
    total_yuklenen = monthly_summary['Yüklenen'].sum()
    basari_orani = (tam_yukleme / total_months * 100) if total_months > 0 else 0
    
    # Toplam sipariş sayısını hesapla (benzersiz sipariş no + miktar kombinasyonları)
    total_orders = len(df_unique_orders)
    
    summary_text = f"""📊 ÖZET BİLGİLER - {selected_supplier}

📅 Toplam Ay Sayısı: {total_months}
📦 Benzersiz Sipariş Kombinasyonu: {total_orders} adet (Sipariş No + Miktar)
✅ Tam Yükleme: {tam_yukleme} ay ({(tam_yukleme/total_months*100 if total_months else 0):.1f}%)
⚠️ Eksik Yükleme: {eksik_yukleme} ay
📈 Fazla Yükleme: {fazla_yukleme} ay

💼 Toplam Sipariş Miktarı: {total_siparis:,.0f} adet
📦 Toplam Yüklenen: {total_yuklenen:,.0f} adet
🎯 Başarı Oranı: {basari_orani:.1f}%"""
    
    eksik_fazla_summary_label.configure(text=summary_text, fg="#2c3e50")
    
    # LOG
    if activity_logger:
        activity_logger.log_analysis("EKSIK_FAZLA_YUKLEME", f"Tedarikçi: {selected_supplier}, Başarı: {basari_orani:.1f}%", "Eksik-Fazla Yüklemeler")

