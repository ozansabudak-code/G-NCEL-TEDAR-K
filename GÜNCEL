                    root.after(0, lambda: update_result_text(error_msg))
                    return
                
                # Verileri hazırla
                dates = [d.strftime("%d.%m.%Y") for d in interest_data.index]
                values = interest_data[search_term].tolist()
                
                # İstatistikler
                avg_value = sum(values) / len(values)
                max_value = max(values)
                min_value = min(values)
                current_value = values[-1]
                
                # Trend yönü
                if len(values) >= 2:
                    change = current_value - values[0]
                    change_pct = (change / values[0] * 100) if values[0] > 0 else 0
                    trend_direction = "Yükseliş ↗" if change > 0 else "Düşüş ↘" if change < 0 else "Stabil →"
                    trend_color = "green" if change > 0 else "red" if change < 0 else "gray"
                else:
                    change_pct = 0
                    trend_direction = "Belirsiz"
                    trend_color = "gray"
                
                # Sonuç metnini hazırla
                result_msg = f"📊 '{search_term}' TREND ANALİZİ\n"
                result_msg += f"{'='*60}\n\n"
                result_msg += f"Zaman Aralığı: {dict(timeframe_options)[timeframe_var.get()]}\n"
                result_msg += f"Bölge: Türkiye\n\n"
                result_msg += f"📈 İSTATİSTİKLER:\n"
                result_msg += f"   Mevcut İlgi Skoru: {current_value}/100\n"
                result_msg += f"   Ortalama: {avg_value:.1f}\n"
                result_msg += f"   Maksimum: {max_value}\n"
                result_msg += f"   Minimum: {min_value}\n\n"
                result_msg += f"📉 TREND YÖNÜ: {trend_direction}\n"
                result_msg += f"   Değişim: {change_pct:+.1f}%\n\n"
                result_msg += f"💡 YORUM:\n"
                
                if current_value > 75:
                    result_msg += f"   🔥 Çok yüksek ilgi! Bu terim şu anda çok popüler.\n"
                elif current_value > 50:
                    result_msg += f"   ✅ Yüksek ilgi seviyesi. İyi bir trend.\n"
                elif current_value > 25:
                    result_msg += f"   ⚠️ Orta seviye ilgi. Potansiyel var.\n"
                else:
                    result_msg += f"   📉 Düşük ilgi seviyesi.\n"
                
                if change_pct > 50:
                    result_msg += f"   🚀 Hızlı yükseliş! Viral olabilir.\n"
                elif change_pct < -50:
                    result_msg += f"   ⚠️ Hızlı düşüş! İlgi azalıyor.\n"
                
                # UI'yi güncelle
                root.after(0, lambda: update_result_text(result_msg))
                root.after(0, lambda: draw_trend_chart(dates, values, search_term, trend_color))
                
            except Exception as e:
                error_msg = f"❌ Hata oluştu\n\n"
                error_type = type(e).__name__
                error_details = str(e)
                
                # Google Trends özel hata mesajları
                if "429" in error_details or "Too Many Requests" in error_details:
                    error_msg += "⏳ Google Trends çok fazla istek algıladı.\n\n"
                    error_msg += "Çözümler:\n"
                    error_msg += "• 10-15 dakika bekleyip tekrar deneyin\n"
                    error_msg += "• Farklı bir arama terimi deneyin\n"
                    error_msg += "• İnternet bağlantınızı kontrol edin\n"
                elif "ResponseError" in error_type or "400" in error_details:
                    error_msg += "🔍 Arama terimi veya zaman aralığı hatalı olabilir.\n\n"
                    error_msg += "Çözümler:\n"
                    error_msg += "• Daha genel bir terim deneyin (ör: 'moda' yerine 'tekstil')\n"
                    error_msg += "• Türkçe karakterler kullanmayı deneyin\n"
                    error_msg += "• Farklı bir zaman aralığı seçin\n"
                elif "Timeout" in error_type or "timeout" in error_details.lower():
                    error_msg += "⏱️ İstek zaman aşımına uğradı.\n\n"
                    error_msg += "Çözümler:\n"
                    error_msg += "• İnternet bağlantınızı kontrol edin\n"
                    error_msg += "• Birkaç saniye bekleyip tekrar deneyin\n"
                else:
                    error_msg += f"Hata Tipi: {error_type}\n"
                    error_msg += f"Detay: {error_details}\n\n"
                    error_msg += "Çözümler:\n"
                    error_msg += "• Farklı bir arama terimi deneyin\n"
                    error_msg += "• İnternet bağlantınızı kontrol edin\n"
                    error_msg += "• Birkaç dakika sonra tekrar deneyin\n"
                    error_msg += "• pytrends kütüphanesinin yüklü olduğundan emin olun\n"
                
                root.after(0, lambda: update_result_text(error_msg))
        
        # Thread başlat
        threading.Thread(target=_search_thread, daemon=True).start()
    
