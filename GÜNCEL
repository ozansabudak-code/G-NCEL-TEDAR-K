        # Export Buttons
        btn_xls = tk.Button(filter_frame, text="Excel", bg="#27ae60", fg="white", font=("Segoe UI", 8), command=lambda: export_rek_df_to_excel(current_data_detail, "Rek_Detayli"))
        btn_xls.pack(side="right", padx=5)
