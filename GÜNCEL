def get_db_connection():
    """Bağlantı havuzundan bağlantı al"""
    global _db_connection_pool
    
    if not MYSQL_AVAILABLE:
        return None
    
    if _db_connection_pool is None:
        try:
            from mysql.connector import pooling
            # MYSQL_CONFIG kontrolü
            if not all([MYSQL_CONFIG.get("host"), MYSQL_CONFIG.get("user"), MYSQL_CONFIG.get("database")]):
                return None
            
            _db_connection_pool = pooling.MySQLConnectionPool(
                pool_name="tedarik_pool",
                pool_size=5,
                host=MYSQL_CONFIG["host"],
                user=MYSQL_CONFIG["user"],
                password=MYSQL_CONFIG["password"],
                database=MYSQL_CONFIG["database"]
            )
        except Exception as e:
            print(f"Connection pool error: {e}")
            return None
    
    try:
        return _db_connection_pool.get_connection()
    except Exception as e:
        print(f"Get connection error: {e}")
        return None

def flush_activity_logs():
    """Buffer'daki tüm logları veritabanına yaz"""
    global _activity_log_buffer
    
    if not _activity_log_buffer:
        return
    
    def _write():
        conn = get_db_connection()
        if conn:
            try:
                cursor = conn.cursor()
                for log in _activity_log_buffer:
                    try:
                        cursor.execute(
                            "INSERT INTO activity_logs (user, action, details, timestamp) VALUES (%s, %s, %s, %s)",
                            (log["user"], log["action"], log["details"], log["timestamp"])
                        )
                    except:
                        pass  # Tablo yoksa veya hata varsa sessizce devam et
                conn.commit()
                cursor.close()
                conn.close()
            except:
                pass
    
    # Thread'de çalıştır
    try:
        run_in_thread(_write)
    except:
        pass
    _activity_log_buffer.clear()

# ---------- BACKUP VE GERİ YÜKLEME SİSTEMİ ----------
def create_backup():
    """
    Tüm ayarları ve önemli verileri yedekler
    """
    try:
        backup_dir = Path("backups")
        backup_dir.mkdir(exist_ok=True)
        
        timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_name = f"tedarik_ai_backup_{timestamp}.zip"
        backup_path = backup_dir / backup_name
        
        # Yedeklenecek dosyalar
        files_to_backup = []
        
        # Ayar dosyası
        if os.path.exists(SETTINGS_FILE):
            files_to_backup.append(SETTINGS_FILE)
        
        # Activity log dosyası
        if os.path.exists("activity_log.json"):
            files_to_backup.append("activity_log.json")
        
        # Zip arşivi oluştur
        with zipfile.ZipFile(backup_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
            for file in files_to_backup:
                if os.path.exists(file):
                    zipf.write(file, arcname=os.path.basename(file))
            
            # Metadata ekle
            metadata = {
                "backup_date": datetime.datetime.now().isoformat(),
                "version": "1.0",
                "files": [os.path.basename(f) for f in files_to_backup]
            }
            zipf.writestr("backup_info.json", json.dumps(metadata, indent=2))
        
        # Eski yedekleri temizle (30 günden eski)
        cleanup_old_backups(backup_dir, days=30)
        
        messagebox.showinfo("Yedekleme Başarılı", 
                          f"✅ Yedek oluşturuldu!\n\nDosya: {backup_name}\n\nKonum: {backup_dir}")
        
        if activity_logger:
            activity_logger.log_event("BACKUP_CREATED", f"Yedek dosyası: {backup_name}")
        
        return True
        
    except Exception as e:
        messagebox.showerror("Yedekleme Hatası", f"Yedek oluşturulamadı:\n{str(e)}")
        if activity_logger:
            activity_logger.log_error(f"Yedekleme hatası: {str(e)}")
        return False

def restore_backup():
    """
    Yedek dosyasından ayarları geri yükler
    """
    try:
        backup_file = filedialog.askopenfilename(
            title="Yedek Dosyası Seç",
            filetypes=[("Zip Dosyaları", "*.zip"), ("Tüm Dosyalar", "*.*")],
            initialdir="backups" if os.path.exists("backups") else "."
        )
        
        if not backup_file:
            return False
        
        # Onay al
        result = messagebox.askyesno("Geri Yükleme Onayı",
                                     "Mevcut ayarlar yedek dosya ile değiştirilecek.\n\n"
                                     "Devam etmek istiyor musunuz?")
        if not result:
            return False
        
        # Zip dosyasını aç
        with zipfile.ZipFile(backup_file, 'r') as zipf:
            # Metadata'yı oku
            try:
                metadata_content = zipf.read("backup_info.json")
                metadata = json.loads(metadata_content)
                backup_date = metadata.get("backup_date", "Bilinmiyor")
            except:
                backup_date = "Bilinmiyor"
            
            # Tüm dosyaları çıkar
            zipf.extractall(".")
        
        messagebox.showinfo("Geri Yükleme Başarılı",
                          f"✅ Yedek geri yüklendi!\n\nYedek tarihi: {backup_date}\n\n"
                          f"Program yeniden başlatılmalı.")
        
        if activity_logger:
            activity_logger.log_event("BACKUP_RESTORED", f"Yedek dosyası: {os.path.basename(backup_file)}")
        
        return True
        
    except Exception as e:
        messagebox.showerror("Geri Yükleme Hatası", f"Yedek geri yüklenemedi:\n{str(e)}")
        if activity_logger:
            activity_logger.log_error(f"Geri yükleme hatası: {str(e)}")
        return False

def cleanup_old_backups(backup_dir, days=30):
    """
    Eski yedekleri temizler
    """
    try:
        cutoff_time = datetime.datetime.now() - datetime.timedelta(days=days)
        
        for backup_file in backup_dir.glob("tedarik_ai_backup_*.zip"):
            file_time = datetime.datetime.fromtimestamp(backup_file.stat().st_mtime)
            if file_time < cutoff_time:
                backup_file.unlink()
                print(f"Eski yedek silindi: {backup_file.name}")
    except Exception as e:
        print(f"Yedek temizleme hatası: {str(e)}")

def auto_backup_schedule():
    """
    Otomatik yedekleme planla
    """
    # Her gün saat 18:00'de otomatik yedek al
    schedule.every().day.at("18:00").do(create_backup)
    print("Otomatik yedekleme planlandı: Her gün 18:00")

