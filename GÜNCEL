    def get_status_and_tag(days_diff):
        """Helper function to determine status and tag based on days remaining"""
        if days_diff < 0:
            status = f"🔴 Süresi Dolmuş ({abs(days_diff)} gün önce)"
            tag = 'expired'
        elif days_diff <= 15:
            status = f"🟡 Yakında Dolacak"
            tag = 'expiring'
        else:
            status = f"🟢 Geçerli"
            tag = 'valid'
        return status, tag
    
    def refresh_detail_table():
        """Detaylı tabloyu yenile"""
        # Mevcut kayıtları temizle
        for item in detail_tree.get_children():
