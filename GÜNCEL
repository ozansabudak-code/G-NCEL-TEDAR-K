class MyEventHandler(FileSystemEventHandler):
    def on_created(self, event):
        if not event.is_directory and event.src_path.lower().endswith(('.xlsx', '.csv')):
            set_status(f"Yeni dosya: {os.path.basename(event.src_path)}")
            # Otomatik dosya yükleme
            self._auto_load_file(event.src_path)
    
    def _auto_load_file(self, file_path):
        """Yeni dosyayı otomatik olarak yükler"""
        global file_paths_global, all_stock_codes
        try:
            # Dosya tam yazılana kadar kısa bir bekleme
            import time
            time.sleep(0.5)
            
            # Dosyayı file_paths_global'e ekle
            file_paths_global = [file_path]
            root.after(0, lambda: set_status(f"{os.path.basename(file_path)} otomatik yüklendi."))
            
            # Stok kodlarını çıkar
            try:
                df_temp = pd.read_csv(file_path, dtype=str) if file_path.endswith('.csv') else pd.read_excel(file_path, dtype=str)
                stok_col_temp = find_stok_kodu_column(df_temp)
                if stok_col_temp:
                    unique_kodlar = sorted(df_temp[stok_col_temp].dropna().unique())
                    all_stock_codes = ["Tüm Veri"] + list(unique_kodlar)
                    root.after(0, lambda: stok_kod_combobox.configure(values=all_stock_codes, state="normal"))
                    root.after(0, lambda: stok_kod_combobox.set("Tüm Veri"))
                    
                    # LOG: Otomatik yükleme
                    if activity_logger:
                        activity_logger.log_event("AUTO_FILE_LOAD", f"Dosya: {os.path.basename(file_path)}, Stok sayısı: {len(unique_kodlar)}", "Analiz")
            except Exception as e:
                root.after(0, lambda: set_status(f"Dosya yüklendi ama stok kodları çıkarılamadı: {str(e)}"))
                if activity_logger:
                    activity_logger.log_error(f"Stok kodu çıkarma hatası: {str(e)}", "Analiz")
                    
        except Exception as e:
            root.after(0, lambda: set_status(f"Dosya yükleme hatası: {str(e)}"))
            if activity_logger:
                activity_logger.log_error(f"Otomatik dosya yükleme hatası: {str(e)}", "Analiz")

