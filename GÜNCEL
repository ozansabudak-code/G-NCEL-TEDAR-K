def create_mysql_connection():
    """
    MySQL bağlantısı oluşturur (Connection pool kullanır).
    
    Returns:
        connection: MySQL bağlantı nesnesi veya None
    """
    if not MYSQL_AVAILABLE:
        messagebox.showerror("Hata", "MySQL Connector kütüphanesi yüklü değil.\nLütfen 'pip install mysql-connector-python' komutunu çalıştırın.")
        return None
    
    # Yapılandırma kontrolü
    if not all([MYSQL_CONFIG.get("host"), MYSQL_CONFIG.get("user"), MYSQL_CONFIG.get("database")]):
        messagebox.showerror("Hata", "MySQL bağlantı bilgileri eksik!\n\nLütfen kodda MYSQL_CONFIG değerlerini doldurun:\n- host\n- user\n- password\n- database")
        return None
    
    try:
        # Connection pool kullan (performans optimizasyonu)
        connection = get_db_connection()
        
        if connection and connection.is_connected():
            if activity_logger:
                activity_logger.log_event("MYSQL_CONNECT", f"Başarıyla bağlandı: {MYSQL_CONFIG['database']}", "MySQL")
            return connection
        return None
    except Exception as err:
        error_msg = f"MySQL bağlantı hatası: {err}"
        messagebox.showerror("MySQL Hatası", error_msg)
        if activity_logger:
            activity_logger.log_error(error_msg, "MySQL")
        return None

def load_data_from_mysql(query=None, table_name=None):
    """
    MySQL veritabanından veri yükler ve pandas DataFrame döndürür.
    
    Args:
        query: SQL sorgusu (opsiyonel)
        table_name: Tablo adı (query yoksa kullanılır)
    
    Returns:
        pd.DataFrame: Yüklenen veri veya None
    """
    connection = create_mysql_connection()
    if not connection:
        return None
    
    try:
        # Sorgu oluştur
        if query is None:
            if table_name is None:
                messagebox.showerror("Hata", "SQL sorgusu veya tablo adı belirtilmeli!")
                return None
            query = f"SELECT * FROM {table_name}"
        
        # Veriyi oku
        df = pd.read_sql(query, connection)
        
        # LOG: Veri yüklendi
        if activity_logger:
            activity_logger.log_data_load(f"MySQL: {table_name or 'Custom Query'}", len(df), "MySQL")
        
        messagebox.showinfo("Başarılı", f"MySQL'den {len(df)} kayıt yüklendi!")
        return df
        
    except mysql.connector.Error as err:
        error_msg = f"MySQL veri okuma hatası: {err}"
        messagebox.showerror("MySQL Hatası", error_msg)
        if activity_logger:
            activity_logger.log_error(error_msg, "MySQL")
        return None
    except Exception as e:
        error_msg = f"Veri işleme hatası: {str(e)}"
        messagebox.showerror("Hata", error_msg)
        if activity_logger:
            activity_logger.log_error(error_msg, "MySQL")
        return None
    finally:
        if connection and connection.is_connected():
            connection.close()
            if activity_logger:
                activity_logger.log_event("MYSQL_DISCONNECT", "Bağlantı kapatıldı", "MySQL")

def apply_column_mappings(df, data_type):
    """
    SQL sorgusundan gelen kolon isimlerini uygulama beklentilerine göre eşleştirir.
    
    Args:
        df: pandas DataFrame - MySQL'den yüklenen veri
        data_type: str - Veri tipi ("tedarik_analiz", "reklamasyon", "stok")
    
    Returns:
        pd.DataFrame: Kolon isimleri eşleştirilmiş DataFrame
    """
    if data_type not in MYSQL_COLUMN_MAPPINGS:
        return df
    
    mappings = MYSQL_COLUMN_MAPPINGS[data_type]
    if not mappings:
        return df
    
    # Kolon isimlerini eşleştir
    rename_dict = {}
    for sql_col, target_col in mappings.items():
        if sql_col in df.columns:
            rename_dict[sql_col] = target_col
    
    if rename_dict:
        df = df.rename(columns=rename_dict)
        if activity_logger:
            activity_logger.log_event("COLUMN_MAPPING", 
                                     f"{data_type}: {len(rename_dict)} kolon eşleştirildi", 
                                     "MySQL")
    
    return df

