def scroll_ticker_animation():
    """Metni kaydırarak ticker efekti verir."""
    global ticker_animation_active, ticker_animation_job
    
    if not ticker_animation_active:
        return  # Durdurulmuşsa çalışma
    
    try:
        if not ticker_label: 
            return
        
        text = ticker_label.cget("text")
        # İlk karakteri sona al
        new_text = text[1:] + text[0]
        ticker_label.configure(text=new_text)
        # Hız ayarı (ms)
        ticker_animation_job = root.after(200, scroll_ticker_animation)
    except Exception as e:
        # Widget geçersiz veya hata - animasyonu durdur
        print(f"Ticker animation error: {e}")
        ticker_animation_active = False
        if ticker_animation_job:
            try:
                root.after_cancel(ticker_animation_job)
            except:
                pass

