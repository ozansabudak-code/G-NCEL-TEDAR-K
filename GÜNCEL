def on_closing():
    """Uygulama kapatılırken kaynakları temizler ve güvenli çıkış sağlar."""
    try:
        # Bekleyen logları kaydet
        flush_activity_logs()
        
        # Ayarları kaydet
        save_settings()
        
        # Ticker animasyonunu durdur
        stop_ticker_animation()
        
        # Tüm grafikleri temizle
        cleanup_matplotlib_figures()
        
        # Klasör izlemeyi durdur
        if observer:
            try:
                observer.stop()
            except:
                pass
        
        # Harita widget'ı varsa yok et (Tile loader thread'lerini durdurmaya yardımcı olur)
        if map_widget:
            try:
                # Harita widget'ını manuel yok etmek, içindeki resim referanslarını
                # interpreter kapanmadan temizlemeye yardımcı olabilir.
                map_widget.destroy()
            except:
                pass

        root.quit()     # Mainloop'tan çık
        root.destroy()  # Pencereyi yok et
    except Exception as e:
        print(f"Kapatma sırasında hata: {e}")
        # Her durumda çıkmaya çalış
        try:
            import sys
            sys.exit(0)
        except:
            pass

def load_daily_files():
    """Merkezi dosyalardan verileri otomatik yükler (startup'ta çalışır)"""
    global df_global, all_stock_codes, all_stock_groups, status_label, file_paths_global
    
    messages = []
    
    # Tedarik verisini yükle
    if os.path.exists(MASTER_TEDARIK_PATH):
        try:
            print(f"Merkezi Tedarik dosyası bulundu: {MASTER_TEDARIK_PATH}")
            df_global = pd.read_excel(MASTER_TEDARIK_PATH)
            
            # file_paths_global'ı set et (analiz fonksiyonu için gerekli)
            file_paths_global = [MASTER_TEDARIK_PATH]
            
            # Stok kodu kolonunu tespit et
            stok_col = find_stok_kodu_column(df_global)
            if stok_col:
                # all_stock_codes listesini güncelle
                all_stock_codes = sorted(df_global[stok_col].dropna().unique().tolist())
                print(f"Stok kodları güncellendi: {len(all_stock_codes)} adet")
                
                # Combobox'ı güncelle (UI thread'inde)
                if 'stok_kod_combobox' in globals() and stok_kod_combobox:
                    root.after(0, lambda: stok_kod_combobox.configure(values=all_stock_codes, state="normal"))
                    root.after(0, lambda: stok_kod_combobox.set("Tüm Veri"))
            
            # Stok grubu kolonunu tespit et ve all_stock_groups'u güncelle
            stok_grup_col = find_stok_grubu_column(df_global)
            if stok_grup_col:
                unique_gruplar = sorted(df_global[stok_grup_col].dropna().unique().tolist())
                all_stock_groups = ["Tüm Veri"] + unique_gruplar
                print(f"Stok grupları güncellendi: {len(all_stock_groups)-1} adet")
                
                # Stok grup filter combobox'ını güncelle (UI thread'inde)
                # Lambda'da değeri capture etmek için değişkeni kopyalayalım
                gruplar_copy = all_stock_groups.copy()
                if 'stok_grup_filter_combobox' in globals() and stok_grup_filter_combobox:
                    root.after(0, lambda g=gruplar_copy: stok_grup_filter_combobox.configure(values=g))
                    root.after(0, lambda: stok_grup_filter_combobox.set("Tüm Veri"))
            
            messages.append("✅ Merkezi Tedarik verisi yüklendi")
            print(f"Tedarik verisi başarıyla yüklendi: {len(df_global)} satır")
        except Exception as e:
            messages.append(f"❌ Tedarik yükleme hatası: {str(e)}")
            print(f"Tedarik dosyası yükleme hatası: {e}")
    else:
        messages.append(f"⚠️ Tedarik dosyası bulunamadı: {MASTER_TEDARIK_PATH}")
        print(f"Tedarik dosyası bulunamadı: {MASTER_TEDARIK_PATH}")
    
    # Reklamasyon verisini yükle
    if os.path.exists(MASTER_REKLAMASYON_PATH):
        try:
            print(f"Merkezi Reklamasyon dosyası bulundu: {MASTER_REKLAMASYON_PATH}")
            success, message = load_reklamasyon_data(filepath=MASTER_REKLAMASYON_PATH)
            if success:
                messages.append("✅ Merkezi Reklamasyon verisi yüklendi")
                print("Reklamasyon verisi başarıyla yüklendi")
            else:
                messages.append(f"❌ Reklamasyon yükleme hatası: {message}")
                print(f"Reklamasyon yükleme hatası: {message}")
        except Exception as e:
            messages.append(f"❌ Reklamasyon yükleme hatası: {str(e)}")
            print(f"Reklamasyon dosyası yükleme hatası: {e}")
    else:
        messages.append(f"⚠️ Reklamasyon dosyası bulunamadı: {MASTER_REKLAMASYON_PATH}")
        print(f"Reklamasyon dosyası bulunamadı: {MASTER_REKLAMASYON_PATH}")
    
    # Status label'ı güncelle
    if status_label:
        status_text = " | ".join(messages)
        root.after(0, lambda: status_label.configure(text=status_text))
    
    # Veri başarıyla yüklendiyse otomatik analiz başlat
    if df_global is not None and file_paths_global:
        print("Otomatik analiz başlatılıyor...")
        # 500ms sonra analiz başlat (UI tamamen yüklendikten sonra)
        root.after(500, lambda: auto_run_initial_analysis())
    
    print("Merkezi dosya yükleme tamamlandı")

def auto_run_initial_analysis():
    """Başlangıçta tüm veri için otomatik analiz yapar (aykırı değer filtresi olmadan)"""
    global file_paths_global, analiz_filter_type_var, exclude_outliers_var
    
    if not file_paths_global:
        print("Otomatik analiz atlandı: Dosya yüklenmemiş")
        return
    
    try:
        print("Tüm veri analizi başlatılıyor (aykırı değer filtresi olmadan)...")
        
        # Aykırı değer filtresini KAPALI yap (kullanıcı isterse sonra açabilir)
        if 'exclude_outliers_var' in globals() and exclude_outliers_var:
            exclude_outliers_var.set(False)
            print("Aykırı değer filtresi devre dışı bırakıldı (tik kaldırıldı)")
        
        # Filter type'ı "none" olarak ayarla (tüm veri için)
        if 'analiz_filter_type_var' in globals() and analiz_filter_type_var:
            analiz_filter_type_var.set("none")
        
        # Progress bar'ı göster
        if 'ai_progress_bar' in globals() and ai_progress_bar:
            ai_progress_bar.pack(pady=10, fill="x")
            ai_progress_bar.start()
        
        # Loading gif'i başlat
        if 'play_loading_gif' in globals():
            play_loading_gif()
        
        # Analiz thread'ini başlat (filter_type="none", filter_value="" ile tüm veri)
        analysis_thread = threading.Thread(
            target=lambda: analiz_et_with_options(file_paths_global, "none", "")
        )
        analysis_thread.daemon = True
        analysis_thread.start()
        
        print("Otomatik analiz başarıyla tetiklendi")
    except Exception as e:
        print(f"Otomatik analiz hatası: {e}")

if __name__ == "__main__":
    # Activity logger'ı başlat
    activity_logger = ActivityLogger()
    
    # Zamanlanmış görevleri ayarla
    def scheduled_report_sender():
        """Zamanlanmış rapor gönderici"""
        while True:
            schedule.run_pending()
            threading.Event().wait(60)  # Her 60 saniyede bir kontrol et
    
    # Günlük saat 16:00'da rapor gönder
    schedule.every().day.at("16:00").do(activity_logger.send_daily_report_email)
    
    # Periyodik raporlar (her 4 saatte bir)
    schedule.every(4).hours.do(activity_logger.send_daily_report_email)
    
    # Otomatik yedekleme planla (Her gün saat 18:00)
    auto_backup_schedule()
    
    # Sözleşme bildirimleri (Her gün saat 09:00)
    schedule.every().day.at("09:00").do(notify_expiring_contracts)
    
    # Kritik alarmlar (Her 4 saatte bir)
    schedule.every(4).hours.do(notify_critical_alerts)
    
    # Scheduler thread'i başlat
    scheduler_thread = threading.Thread(target=scheduled_report_sender, daemon=True)
    scheduler_thread.start()
    
    activity_logger.log_event("APP_START", "Uygulama başlatıldı")
    
    # Başlangıç bildirimi
    show_desktop_notification("Tedarik AI", "Sistem başlatıldı ✅")
    
    load_settings()
    
    # Kapanış fonksiyonunu güncelle
    def on_closing_with_log():
        activity_logger.log_event("APP_CLOSE", "Uygulama kapatılıyor")
        activity_logger.close_session()
        on_closing()
    
    root.protocol("WM_DELETE_WINDOW", on_closing_with_log)
    
    # Market ticker'ı başlat - mainloop başladıktan sonra
    root.after(100, update_market_ticker)
    
    # Merkezi dosyaları otomatik yükle - mainloop başladıktan sonra
    root.after(100, load_daily_files)
    
    # İlk bildirimleri kontrol et (5 saniye sonra)
    root.after(5000, notify_expiring_contracts)
    
    try:
        root.mainloop()
    except KeyboardInterrupt:
        on_closing_with_log()
