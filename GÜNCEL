            return False
        
        # Dosya yoksa oluştur
        if not os.path.exists(MASTER_CARI_BILGILER_PATH):
            # Klasörü oluştur
            os.makedirs(os.path.dirname(MASTER_CARI_BILGILER_PATH), exist_ok=True)
            
            # Yeni workbook oluştur
            wb = Workbook()
            ws = wb.active
            ws.title = "Cari Bilgiler"
            
            # Başlıkları ekle
