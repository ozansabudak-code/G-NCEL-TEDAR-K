        btn = tk.Button(
            parent,
            text=text,
            font=("Segoe UI", 10, "bold"),
            bg=color,
            fg="white",
            activebackground=darken_color(color),
            activeforeground="white",
            relief="raised",
            bd=2,
            cursor="hand2",
            padx=12,
            pady=10,
            command=open_link
        )
        btn.pack(fill="both", expand=True, pady=4)
        
        # Hover efektleri
