def clean_phone_number(phone_number):
    """
    Telefon numarasını temizler ve uluslararası formata çevirir.
    
    Args:
        phone_number: Temizlenecek telefon numarası (str)
    
    Returns:
        str: Temizlenmiş ve formatlanmış telefon numarası (+90XXXXXXXXXX)
        None: Geçersiz numara durumunda
    
    Example:
        clean_phone_number("0555 123 45 67") -> "905551234567"
        clean_phone_number("+90 555 123 45 67") -> "905551234567"
    """
    if not phone_number:
        return None
    
    # Sadece rakamlar ve + işaretini tut
    clean_phone = ''.join(c for c in str(phone_number) if c.isdigit() or c == '+')
    
    if not clean_phone:
        return None
    
    # + işaretini kaldır (ülke kodu ayrı ekleneceği için)
    clean_phone = clean_phone.replace('+', '')
    
    # Eğer 0 ile başlıyorsa, ilk 0'ı kaldır
    if clean_phone.startswith('0'):
        clean_phone = clean_phone[1:]
    
    # Eğer 90 ile başlamıyorsa, Türkiye kodu ekle
    if not clean_phone.startswith('90'):
        clean_phone = '90' + clean_phone
    
    return clean_phone

