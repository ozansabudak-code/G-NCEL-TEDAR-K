# ---------- PERFORMANS OPTİMİZASYONU YARDIMCI FONKSİYONLAR ----------
def run_in_thread(target_func, callback=None, error_callback=None):
    """Thread-safe wrapper for background operations"""
    def _worker():
        try:
            result = target_func()
            if callback:
                root.after(0, lambda: callback(result))
        except Exception as e:
            if error_callback:
                root.after(0, lambda: error_callback(e))
            else:
                print(f"Thread error: {str(e)}")
    
    thread = threading.Thread(target=_worker, daemon=True)
    thread.start()
    return thread

