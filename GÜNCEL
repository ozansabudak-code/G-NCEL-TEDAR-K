                                         anchor="w")
                    name_label.pack(fill="x")
                    
                    # Dosya bilgileri
                    info_text = f"📏 {file_size_kb:.1f} KB  |  📅 {file_mtime.strftime('%d.%m.%Y %H:%M')}"
                    info_label = tk.Label(file_card, text=info_text,
                                         font=("Segoe UI", 8),
                                         bg="#f8f9fa", fg="gray",
                                         anchor="w")
                    info_label.pack(fill="x")
                    
                    # Butonlar
                    btn_frame = tk.Frame(file_card, bg="#f8f9fa")
                    btn_frame.pack(fill="x", pady=(5, 0))
                    
                    def open_file(filepath=pdf_file):
                        try:
                            import subprocess
                            if os.name == 'nt':  # Windows
                                os.startfile(filepath)
                            elif os.name == 'posix':  # macOS/Linux
                                subprocess.call(['open', filepath])
                            if activity_logger:
                                activity_logger.log_event("FILE_OPEN", f"Belge açıldı: {os.path.basename(filepath)}", 
                                                            "Tedarikçi Uyumluluk")
                        except Exception as e:
                            messagebox.showerror("Hata", f"Dosya açılırken hata oluştu:\n{str(e)}")
                    
                    def copy_path(filepath=pdf_file):
                        root.clipboard_clear()
                        root.clipboard_append(filepath)
                        messagebox.showinfo("Başarılı", "Dosya yolu panoya kopyalandı!")
                    
                    open_btn = tk.Button(btn_frame, text="📂 Aç", 
                                        font=("Segoe UI", 8),
                                        bg=color, fg="white",
                                        relief="flat",
                                        cursor="hand2",
                                        padx=8, pady=2,
                                        command=open_file)
                    open_btn.pack(side="left", padx=2)
                    
