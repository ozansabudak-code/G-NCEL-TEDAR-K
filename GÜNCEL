def analyze_pdf_with_gemini(pdf_path):
    """Gemini AI ile PDF belgesi analiz et"""
    try:
        import PyPDF2
        import google.generativeai as genai
        
        # API yapılandırması
        if not GEMINI_API_KEY:
            return {"error": "Gemini API anahtarı tanımlı değil"}
        
        genai.configure(api_key=GEMINI_API_KEY)
        model = genai.GenerativeModel('models/gemini-2.0-flash')
        
        # PDF okuma
        with open(pdf_path, 'rb') as file:
            pdf_reader = PyPDF2.PdfReader(file)
            text = ""
            for page in pdf_reader.pages[:5]:  # İlk 5 sayfa
                text += page.extract_text()
        
        # AI analizi
        prompt = f"""Aşağıdaki Türkçe belgeyi analiz et:

{text[:3000]}

Lütfen şu bilgileri çıkar:
1. Belge Türü (sertifika, sözleşme, izin belgesi, vb.)
2. Tedarikçi/Firma Adı
3. Geçerlilik Tarihi (varsa)
4. Önemli Maddeler
5. Referans Numarası

Cevabını JSON formatında ver."""
        
        response = model.generate_content(prompt)
        return {"success": True, "analysis": response.text}
        
    except Exception as e:
        return {"error": str(e)}

def extract_supplier_info_from_pdf(pdf_path):
    """Sözleşme veya Sertifika PDF'inden tedarikçi bilgilerini AI ile çıkar"""
    try:
        if not GENAI_AVAILABLE or not GEMINI_API_KEY:
            return {"error": "Gemini AI yapılandırılmamış. API anahtarını ayarlayın."}
        
        import google.generativeai as genai
        
        # API yapılandırması
        genai.configure(api_key=GEMINI_API_KEY)
        model = genai.GenerativeModel('models/gemini-2.0-flash')
        
        # PDF okuma - Çoklu yöntem denemesi
        print(f"[AI PDF] PDF okunuyor: {pdf_path}")
        text = ""
        extraction_method = "None"
        
        # Yöntem 1: PyPDF2 (varsayılan, hızlı)
        if PYPDF2_AVAILABLE and not text.strip():
            try:
                print("[AI PDF] Yöntem 1: PyPDF2 ile deneniyor...")
                import PyPDF2
                with open(pdf_path, 'rb') as file:
                    pdf_reader = PyPDF2.PdfReader(file)
                    page_count = len(pdf_reader.pages)
                    print(f"[AI PDF] PDF sayfa sayısı: {page_count}")
                    
                    # İlk 10 sayfa veya tüm sayfalara kadar
                    for i, page in enumerate(pdf_reader.pages[:min(10, page_count)]):
                        page_text = page.extract_text()
                        if page_text:
                            text += page_text + "\n"
                    
                    if text.strip():
                        extraction_method = "PyPDF2"
                        print(f"[AI PDF] PyPDF2 ile {len(text)} karakter çıkarıldı")
            except Exception as e:
                print(f"[AI PDF] PyPDF2 hatası: {e}")
        
        # Yöntem 2: pdfplumber (daha güçlü, daha yavaş)
        if not text.strip():
            try:
                print("[AI PDF] Yöntem 2: pdfplumber ile deneniyor...")
                import pdfplumber
                with pdfplumber.open(pdf_path) as pdf:
                    page_count = len(pdf.pages)
                    print(f"[AI PDF] PDF sayfa sayısı: {page_count}")
                    
                    for i, page in enumerate(pdf.pages[:min(10, page_count)]):
                        page_text = page.extract_text()
                        if page_text:
                            text += page_text + "\n"
                    
                    if text.strip():
                        extraction_method = "pdfplumber"
                        print(f"[AI PDF] pdfplumber ile {len(text)} karakter çıkarıldı")
            except ImportError:
                print("[AI PDF] pdfplumber yüklü değil, alternatif yöntem kullanılacak")
            except Exception as e:
                print(f"[AI PDF] pdfplumber hatası: {e}")
        
        # Yöntem 3: pdfminer.six (en güçlü, en yavaş)
        if not text.strip():
            try:
                print("[AI PDF] Yöntem 3: pdfminer ile deneniyor...")
                from pdfminer.high_level import extract_text as pdfminer_extract
                text = pdfminer_extract(pdf_path, maxpages=10)
                if text.strip():
                    extraction_method = "pdfminer"
                    print(f"[AI PDF] pdfminer ile {len(text)} karakter çıkarıldı")
            except ImportError:
                print("[AI PDF] pdfminer.six yüklü değil")
            except Exception as e:
                print(f"[AI PDF] pdfminer hatası: {e}")
        
        # Hiçbir yöntem çalışmadıysa
        if not text.strip():
            error_msg = (
                "PDF'den metin çıkarılamadı.\n\n"
                "Olası nedenler:\n"
                "1. PDF taranmış (image-based) olabilir - OCR gerekiyor\n"
                "2. PDF şifreli veya korumalı olabilir\n"
                "3. PDF bozuk veya okunamaz durumda\n\n"
                "Çözüm önerileri:\n"
                "- PDF'i Adobe Reader ile açıp tekrar kaydedin\n"
                "- PDF'i text-based format olarak export edin\n"
                "- Manuel olarak bilgileri girin"
            )
            return {"error": error_msg}
        
        # Başarı mesajı
        print(f"[AI PDF] ✅ Metin başarıyla çıkarıldı ({extraction_method} yöntemi)")
        print(f"[AI PDF] Toplam {len(text)} karakter, ilk 200: {text[:200]}...")
        
        # AI ile analiz
        prompt = f"""Aşağıdaki Türkçe sözleşme veya sertifika belgesini analiz et ve tedarikçi bilgilerini çıkar.

Belge Metni:
{text[:5000]}

Lütfen şu bilgileri çıkar ve JSON formatında ver:
{{
    "tedarikci_adi": "Tedarikçi firma adı",
    "yetkili_kisi": "Yetkili kişinin adı soyadı",
    "telefon": "Telefon numarası",
    "mail": "Email adresi",
    "adres": "Şirket adresi",
    "alim_turu": "Kumaş, Fire, Tekleme, Aksesuar veya Diğer (belgeden tahmin et)",
    "sozlesme_baslangic": "Sözleşme başlangıç tarihi YYYY-MM-DD formatında",
    "sozlesme_bitis": "Sözleşme bitiş tarihi YYYY-MM-DD formatında",
    "sertifika_bitis": "Sertifika bitiş tarihi YYYY-MM-DD formatında",
    "belge_turu": "Sözleşme veya Sertifika"
}}

Eğer bir bilgi bulunamazsa null değeri ver.
Sadece JSON formatında yanıt ver, başka açıklama ekleme."""
        
        print(f"[AI PDF] AI analizi yapılıyor (çıkarma yöntemi: {extraction_method})...")
        response = model.generate_content(prompt)
        
        # JSON parse et
        import json
        import re
        
        # JSON'u metinden çıkar
        response_text = response.text
        # Markdown code block varsa temizle
        response_text = re.sub(r'```json\s*', '', response_text)
        response_text = re.sub(r'```\s*', '', response_text)
        response_text = response_text.strip()
        
        print(f"[AI PDF] AI yanıtı: {response_text[:200]}...")
        
        try:
            data = json.loads(response_text)
            print(f"[AI PDF] Çıkarılan bilgiler: {data}")
            return {"success": True, "data": data}
        except json.JSONDecodeError as e:
            print(f"[AI PDF] JSON parse hatası: {e}")
            # JSON parse edilemezse ham metin döndür
            return {"success": False, "raw_text": response_text, "error": "JSON formatı hatalı"}
        
    except Exception as e:
        print(f"[AI PDF] Hata: {e}")
        import traceback
        traceback.print_exc()
        return {"error": str(e)}

