def send_chat_message(entry_widget):
    query = entry_widget.get().strip()
    if not query: return
    
    chat_history_text.configure(state="normal")
    chat_history_text.insert("end", f"\nSiz: {query}\n", "user")
    chat_history_text.configure(state="disabled")
    entry_widget.delete(0, 'end')
    
    threading.Thread(target=lambda: fetch_chat_response(query), daemon=True).start()

def fetch_chat_response(query):
    if not GEMINI_API_KEY:
        append_chat_response("Hata: API Anahtarı eksik.", "error")
        return

    # Veri konteksti oluştur
    context_data = ""
    has_data = False
    
    if sonuc_global is not None:
        has_data = True
        context_data = f"Veri Özeti (İlk 50 Kayıt):\n{sonuc_global.head(50).to_string()}\n"
        context_data += f"\nSütunlar: {list(sonuc_global.columns)}\n"
    
    # Ham veri de varsa ekle
    if df_global is not None:
        has_data = True
        context_data += f"\n\nHam Veri Özeti (İlk 30 Kayıt):\n{df_global.head(30).to_string()}\n"
        context_data += f"\nToplam Kayıt Sayısı: {len(df_global)}\n"

    # Geliştirilmiş prompt - Defacto Üretim kişiliği ve tekstil uzmanlığı
    prompt = f"""
    Sen "Defacto Üretim" adında, tekstil sektöründe uzmanlaşmış yapay zeka asistanısın.
    
    KİŞİLİĞİN VE UZMANLIĞIN:
    - İsmin: Defacto Üretim
    - Uzmanlık: Tekstil üretimi, kumaş teknolojileri, tedarik zinciri yönetimi, kalite kontrol
    - Tekstil bilgin: Dokuma, örme, boya, baskı, aksesuar, konfeksiyon, hammadde (pamuk, polyester, elastan vb.)
    - Davranış: Sıcak, yardımsever, profesyonel ve konuşkan
    - Her zaman samimi ve dostça yanıtlar verirsin
    
    GÖREVIN:
    1. Kullanıcı selamlaştığında (merhaba, selam, hello vb.) karşılık ver ve kendini tanıt
    2. Sohbet etmeye hazır ol - sadece veri analizi değil, tekstil hakkında genel sorulara da cevap ver
    3. Yüklenen verilere %100 odaklan ve veriden içgörüler sun
    4. Veri yoksa bile tekstil sektörü hakkında bilgi ver ve yardımcı ol
    
    {"VERİ MEVCUT - Analiz edebileceğin veriler:" if has_data else "VERİ YOK - Ancak tekstil ve tedarik zinciri hakkında sorular sorabilir."}
    ---
    {context_data if has_data else "Henüz veri yüklenmedi."}
    ---
    
    Kullanıcı Sorusu: {query}
    
    YANITLAMA KURALLARI:
    - Eğer kullanıcı selamlaşıyorsa (merhaba, selam, hello, hi vb.), sıcak karşıla ve kendini tanıt
    - Veri varsa, veriye dayalı detaylı analiz yap
    - Veri yoksa, tekstil sektörü bilginle yardımcı ol ve kullanıcıyı yönlendir
    - Her zaman Türkçe, samimi ve profesyonel yanıt ver
    - Tekstil terimleri kullan ve uzmanlığını göster
    """
    
    try:
        data = {"contents": [{"parts":[{"text": prompt}]}]}
        response = requests.post(f"{GEMINI_API_URL}?key={GEMINI_API_KEY}", headers={"Content-Type": "application/json"}, json=data, timeout=30)
        
        if response.status_code == 200:
            reply = response.json()["candidates"][0]["content"]["parts"][0]["text"].strip()
            append_chat_response(reply, "ai")
        else:
            append_chat_response(f"Hata: API yanıt vermedi. Kod: {response.status_code}", "error")
            
    except Exception as e:
        append_chat_response(f"Bir hata oluştu: {str(e)}", "error")

def append_chat_response(message, tag):
    def _update():
        chat_history_text.configure(state="normal")
        chat_history_text.insert("end", f"\nDefacto Üretim: {message}\n", tag)
        chat_history_text.insert("end", "-"*50 + "\n", "ai")
        chat_history_text.see("end")
        chat_history_text.configure(state="disabled")
    
    if chat_history_text:
        chat_history_text.after(0, _update)

